# Server port
PORT=4000

# SQLite file-based database (Prisma)
DATABASE_URL="file:./dev.db"

# JWT signing secret - change in production
JWT_SECRET="ticketsense-dev-secret-change-me"

# Organization timezone used for business-hours SLA calculations (IANA name)
ORG_TIMEZONE="Asia/Kolkata"

# ---- Optional AI provider integration ----
# TicketSense ships with a fully working, deterministic rule/keyword-based
# classifier (server/src/ai/deterministicClassifier.ts) that requires NO key.
# If AI_PROVIDER is set to something other than "deterministic" AND
# AI_PROVIDER_API_KEY is present, server/src/ai/provider.ts provides a seam
# where a real LLM call could be wired in. Leaving these unset is fully
# supported and is the default/shipped behavior.
AI_PROVIDER="deterministic"
AI_PROVIDER_API_KEY=
